# Frontend build-time settings (Vercel)
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=replace_with_restricted_browser_key

# Backend runtime settings (Render / backend/.env)
GEMINI_API_KEY=replace_with_server_side_gemini_key
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_URLS=http://localhost:5173
PORT=5000
# Optional local override; Render Docker image sets this automatically.
# PYTHON=python
